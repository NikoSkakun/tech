{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Chapter content export (one file per chapter of a volume)",
 "description": "One file per chapter, generated by tools/content/export_content.py from docs/volumes/<volume>/chapters/<id>.md. Strings are Ukrainian on-screen copy with mini-markup: **term**, _emphasis_, `formula`; U+00A0 between number and unit is significant.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "volume",
  "id",
  "title",
  "order",
  "group",
  "parent",
  "groupLabel",
  "axisLabel",
  "axisRaw",
  "accentMood",
  "notes",
  "learningGoals",
  "visualIdea",
  "steps",
  "models",
  "glossary",
  "quiz",
  "crossReferences",
  "source"
 ],
 "properties": {
  "schemaVersion": {
   "type": "integer",
   "enum": [
    2
   ]
  },
  "volume": {
   "type": "string",
   "minLength": 1,
   "description": "id of the volume the chapter belongs to; the full chapter id is <volume>/<id>"
  },
  "id": {
   "type": "string",
   "minLength": 1,
   "description": "chapter id (kebab-case), unique inside its volume"
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "order": {
   "type": "integer",
   "minimum": 1,
   "description": "position in the journey, 1…25"
  },
  "group": {
   "type": "string",
   "minLength": 1,
   "description": "id of the chapter's group — one of the volume's groups (volume.json → groups)"
  },
  "parent": {
   "type": [
    "string",
    "null"
   ],
   "description": "`plants` for plant chapters, `home` for labs"
  },
  "groupLabel": {
   "type": "string",
   "description": "text of the «Група» header field"
  },
  "axisLabel": {
   "type": "string",
   "description": "short label of the chapter's place on the volume's journey axis, e.g. 10⁻⁹ m"
  },
  "axisRaw": {
   "type": "string",
   "description": "full text of the axis header field (its name is volume.json → axis.label; «Масштаб» for electricity)"
  },
  "accentMood": {
   "type": "string",
   "description": "text of the «Акцентний колір/настрій» header field (palette tokens in backticks)"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "author/reviewer notes from the header block quotes (not on-screen copy)"
  },
  "learningGoals": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "visualIdea": {
   "type": "string",
   "description": "raw Markdown of the «Наскрізна візуальна ідея» section (scene bible; not on-screen copy)"
  },
  "steps": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/step"
   },
   "minItems": 1
  },
  "models": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title"
    ],
    "properties": {
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "title": {
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "description": "simulation models of the «Модель симуляції» section (ids/titles only; the specification stays in the document)"
  },
  "glossary": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "international",
     "ukrainian",
     "symbol",
     "unit",
     "definition"
    ],
    "properties": {
     "international": {
      "type": "string",
      "minLength": 1
     },
     "ukrainian": {
      "type": "string",
      "minLength": 1
     },
     "symbol": {
      "type": [
       "string",
       "null"
      ]
     },
     "unit": {
      "type": [
       "string",
       "null"
      ]
     },
     "definition": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "quiz": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/quizItem"
   }
  },
  "simpleQuiz": {
   "type": "array",
   "description": "the «Простий квіз» section (key only when present)",
   "items": {
    "$ref": "#/$defs/quizItem"
   }
  },
  "crossReferences": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "where",
     "targets",
     "note"
    ],
    "properties": {
     "where": {
      "type": "string"
     },
     "targets": {
      "type": "array",
      "description": "full step addresses: <volume>/<chapter>/<step>",
      "items": {
       "type": "string",
       "minLength": 5
      },
      "minItems": 1
     },
     "note": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "additionalProperties": false
   },
   "description": "links to steps of other chapters (`chapter/step`)"
  },
  "source": {
   "type": "object",
   "required": [
    "document",
    "generator"
   ],
   "properties": {
    "document": {
     "type": "string"
    },
    "generator": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 },
 "$defs": {
  "step": {
   "type": "object",
   "required": [
    "n",
    "id",
    "title",
    "see",
    "panel",
    "terms",
    "formulas",
    "facts",
    "interaction",
    "hotspots",
    "misconceptions",
    "transition",
    "links",
    "termsNote",
    "hotspotsNote"
   ],
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 1
    },
    "id": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "see": {
     "type": [
      "string",
      "null"
     ],
     "description": "«Бачимо»: scene / camera description for the builder (not on-screen copy)"
    },
    "panel": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1,
     "description": "panel pages in order; delimiters stripped, quotes re-levelled; ≤ 450 characters of plain text each"
    },
    "terms": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/term"
     }
    },
    "formulas": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "items",
      "raw"
     ],
     "additionalProperties": false,
     "properties": {
      "items": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "raw": {
       "type": "string",
       "description": "whole field with explanatory text"
      }
     }
    },
    "facts": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "note",
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "text",
         "source"
        ],
        "properties": {
         "text": {
          "type": "string",
          "minLength": 1
         },
         "source": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "additionalProperties": false
       }
      }
     }
    },
    "interaction": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "note",
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "items": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "text",
         "controls"
        ],
        "properties": {
         "text": {
          "type": "string",
          "minLength": 1
         },
         "controls": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/control"
          }
         }
        },
        "additionalProperties": false
       }
      }
     }
    },
    "hotspots": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/hotspot"
     }
    },
    "misconceptions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "myth",
       "correction",
       "raw"
      ],
      "properties": {
       "myth": {
        "type": [
         "string",
         "null"
        ]
       },
       "correction": {
        "type": "string"
       },
       "raw": {
        "type": "string"
       },
       "scene": {
        "type": "string",
        "minLength": 1,
        "description": "builder guidance of the misconception — the «[Сцена: …]» part (key only when present); never shown"
       }
      },
      "additionalProperties": false
     }
    },
    "transition": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "note",
      "text"
     ],
     "additionalProperties": false,
     "properties": {
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "text": {
       "type": "string"
      }
     }
    },
    "links": {
     "type": [
      "string",
      "null"
     ],
     "description": "«Зв’язки» field where present"
    },
    "termsNote": {
     "type": [
      "string",
      "null"
     ],
     "description": "free text of the «Терміни» field that is not a term"
    },
    "hotspotsNote": {
     "type": [
      "string",
      "null"
     ],
     "description": "free text of the «Hotspots» field that is not a hotspot (builder remark)"
    },
    "simple": {
     "type": "object",
     "description": "the simple reading level of the step («Просто», docs/briefs/L-simple-level.md §3); key only in steps that have the block",
     "required": [
      "title",
      "panel",
      "words",
      "facts",
      "hotspots",
      "misconception",
      "notes"
     ],
     "additionalProperties": false,
     "properties": {
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "panel": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "words": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "word",
         "text"
        ],
        "additionalProperties": false,
        "properties": {
         "word": {
          "type": "string",
          "minLength": 1
         },
         "text": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      },
      "facts": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "hotspots": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id",
         "text"
        ],
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "text": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      },
      "misconception": {
       "type": [
        "object",
        "null"
       ],
       "required": [
        "myth",
        "correction"
       ],
       "additionalProperties": false,
       "properties": {
        "myth": {
         "type": "string",
         "minLength": 1
        },
        "correction": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "notes": {
       "type": [
        "string",
        "null"
       ],
       "description": "builder / reviewer guidance («Примітки»), never shown"
      }
     }
    }
   },
   "additionalProperties": false
  },
  "term": {
   "type": "object",
   "required": [
    "international",
    "ukrainian",
    "symbol",
    "unit",
    "raw",
    "definition"
   ],
   "properties": {
    "international": {
     "type": [
      "string",
      "null"
     ]
    },
    "ukrainian": {
     "type": [
      "string",
      "null"
     ]
    },
    "symbol": {
     "type": [
      "string",
      "null"
     ]
    },
    "unit": {
     "type": [
      "string",
      "null"
     ]
    },
    "raw": {
     "type": "string",
     "description": "term line as written"
    },
    "definition": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "hotspot": {
   "type": "object",
   "required": [
    "name",
    "international",
    "ukrainian",
    "note",
    "text",
    "tail"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "international": {
     "type": [
      "string",
      "null"
     ]
    },
    "ukrainian": {
     "type": [
      "string",
      "null"
     ]
    },
    "text": {
     "type": "string",
     "description": "on-screen copy (may be empty when the document only names the hotspot)"
    },
    "tail": {
     "type": [
      "string",
      "null"
     ],
     "description": "text after the quoted hotspot copy (rare remark for the builder)"
    },
    "note": {
     "type": [
      "string",
      "null"
     ],
     "description": "builder remark between the name and the colon, e.g. «(мініатюра на столі)» — not on-screen copy"
    }
   },
   "additionalProperties": false
  },
  "control": {
   "type": "object",
   "required": [
    "type",
    "label",
    "min",
    "max",
    "step",
    "unit",
    "default"
   ],
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "slider",
      "stepper",
      "toggle",
      "segmented",
      "button",
      "drag"
     ]
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    },
    "min": {
     "type": [
      "number",
      "null"
     ]
    },
    "max": {
     "type": [
      "number",
      "null"
     ]
    },
    "step": {
     "type": [
      "number",
      "null"
     ]
    },
    "unit": {
     "type": [
      "string",
      "null"
     ]
    },
    "default": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false,
   "description": "best-effort parse of a UI control; the item text is authoritative"
  },
  "quizItem": {
   "type": "object",
   "required": [
    "question",
    "options",
    "correct",
    "explanation"
   ],
   "properties": {
    "question": {
     "type": "string",
     "minLength": 1
    },
    "options": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 2
    },
    "correct": {
     "type": "integer",
     "minimum": 0,
     "description": "0-based index into options"
    },
    "explanation": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  }
 }
}
